# Supabase — pega em Project Settings > API no painel do Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role: SÓ no servidor (pipeline). Nunca expor no client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Claude API — pega em console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-key

# Gate de acesso do piloto (opcional). Se BOREAL_GATE_PASSWORD estiver setada, o app fica privado:
# pede essa senha em /acesso e libera por 30 dias. Sem ela, o app fica aberto (dev/local).
# BOREAL_GATE_SECRET assina o cookie de sessão — troque por um valor aleatório em produção.
BOREAL_GATE_PASSWORD=
BOREAL_GATE_SECRET=troque-por-um-valor-aleatorio-longo

# Google Cloud / BigQuery — Base dos Dados
# GCP_PROJECT_ID: billing project (ex: boreal-497620)
# GCP_KEY_PATH: caminho relativo à raiz do projeto para o JSON da service account
GCP_PROJECT_ID=your-gcp-project-id
GCP_KEY_PATH=.gcp/your-service-account-key.json
